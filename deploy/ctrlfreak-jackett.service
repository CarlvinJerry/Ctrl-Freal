[Unit]
Description=Ctrl Freak private Jackett indexer service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=carlvinjerry
Group=carlvinjerry
WorkingDirectory=/home/carlvinjerry/tcl-remote/indexer/Jackett
Environment=XDG_CONFIG_HOME=/home/carlvinjerry/tcl-remote/indexer/config
ExecStart=/home/carlvinjerry/tcl-remote/indexer/Jackett/jackett --ListenPrivate --NoUpdates
Restart=on-failure
RestartSec=8
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

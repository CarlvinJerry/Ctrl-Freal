 let mainWindow;
+let windowDisplaySize;
+let displayResizeTimer;
+let displayWatcherInstalled = false;
+
+// Recreate only the local HDMI window when the TV changes its reported size.
+// The MagicMirror server and its responsive CSS keep running for other screens.
+const checkDisplaySize = () => {
+	if (!mainWindow || mainWindow.isDestroyed()) return;
+	const size = electron.screen.getPrimaryDisplay().workAreaSize;
+	if (size.width === windowDisplaySize.width && size.height === windowDisplaySize.height) return;
+	clearTimeout(displayResizeTimer);
+	displayResizeTimer = setTimeout(() => {
+		if (!mainWindow || mainWindow.isDestroyed()) return;
+		const stable = electron.screen.getPrimaryDisplay().workAreaSize;
+		if (stable.width !== windowDisplaySize.width || stable.height !== windowDisplaySize.height) {
+			Log.log(`HDMI size changed to ${stable.width}x${stable.height}; reopening local mirror window.`);
+			mainWindow.destroy();
+		}
+	}, 2500);
+};
+
+const installDisplayWatcher = () => {
+	if (displayWatcherInstalled) return;
+	displayWatcherInstalled = true;
+	electron.screen.on("display-metrics-changed", checkDisplaySize);
+	electron.screen.on("display-added", checkDisplaySize);
+	electron.screen.on("display-removed", checkDisplaySize);
+	setInterval(checkDisplaySize, 5000);
+};
 
